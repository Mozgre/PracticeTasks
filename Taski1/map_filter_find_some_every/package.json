{
    "name": "array-methods",
    "version": "1.0.0",
    "scripts": {
      "test": "jest",
      "test:watch": "jest --watchAll",
      "test:every": "jest every/every.test.js",
      "test:filter": "jest filter/filter.test.js",
      "test:find": "jest find/find.test.js",
      "test:map": "jest map/map.test.js",
      "test:some": "jest some/some.test.js",
      "coverage": "jest --collectCoverage"
    },
    "devDependencies": {
      "jest": "^29.7.0"
    },
    "jest": {
      "testMatch": [
        "**/*.test.js"
      ],
      "collectCoverageFrom": [
        "**/*.js",
        "!**/node_modules/**",
        "!**/coverage/**"
      ],
      "coverageReporters": [
        "text",
        "lcov"
      ]
    }
  }